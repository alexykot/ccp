{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:control-plane:contracts:progress.schema.json",
  "title": "ControlPlaneProgress",
  "description": "QUEUE_ROOT/progress/<task_id>.json: the task's phase moves, one event each, which ccp health reads for start times (SPEC §10.1, §23.7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "events",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "from",
          "to",
          "note"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "from": {
            "type": [
              "string",
              "null"
            ],
            "description": "The SPEC §10.1 phase the task left; null for its first move"
          },
          "to": {
            "type": "string",
            "description": "The SPEC §10.1 phase the task moved to"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
