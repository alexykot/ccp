{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:control-plane:contracts:task.schema.json",
  "title": "ControlPlaneTask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "title",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable id shared with durable docs/ DAG"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "leased",
        "implementing",
        "implemented",
        "reviewing",
        "fixing",
        "reviewed",
        "submitted",
        "verifying",
        "merging",
        "done",
        "blocked",
        "failed",
        "dropped"
      ]
    },
    "spec_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "task_id list that must be done (or waived) before claim/verify. Authoritative for gating — never only mentioned inside dod_checks prose."
    },
    "adr_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "kind": {
      "type": "string",
      "description": "The task file's kind (plane.json task_log.kinds), feature when it names none"
    },
    "branch": {
      "type": "string",
      "description": "The task branch, task/<task_id>"
    },
    "worktree_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "The implementer worktree claim made, or null when the product makes none"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "The first claim; a later claim of a released task keeps it"
    },
    "lease_since": {
      "type": "string",
      "format": "date-time"
    },
    "pr": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "merge_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "durable_path": {
      "type": "string",
      "description": "Path under product docs/, e.g. docs/delivery/tasks.md#slice-x"
    },
    "env_slug": {
      "type": "string",
      "description": "Adapter env / worktree slug"
    },
    "claude_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "pr_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "integration_branch": {
      "type": "string"
    },
    "waiting_on": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "operator_decision",
        "reauth",
        "quota",
        "steerer",
        "spec_maintainer",
        "design_seat",
        "runner",
        "null-class",
        "operator_step",
        null
      ],
      "description": "spec_maintainer = blocked on an open spec-maintainer question (§17); steerer stays for projects without a spec_maintainer block"
    },
    "waiting_on_since": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "planned_resume_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Structured resume/reset time (quota resets_at). Watchdog prefers this over prose notes."
    },
    "quota_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "session",
        "credit",
        null
      ]
    },
    "implementation_started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lease_holder": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  }
}
