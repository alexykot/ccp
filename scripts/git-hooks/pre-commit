#!/usr/bin/env bash
# The plane's main moves only by merged pull requests: refuse a commit on main (CLAUDE.md).
# Installed by scripts/install-git-hooks.sh. CCP_ALLOW_MAIN_COMMIT=1 overrides (emergencies only).
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = main ] && [ -z "${CCP_ALLOW_MAIN_COMMIT:-}" ]; then
  echo "pre-commit: refusing to commit on main. Develop on a branch in a worktree: scripts/dev-worktree.sh <branch>" >&2
  exit 1
fi
# A claimed task's file is edited only in its PR (SPEC §10.5): with a queue bound (QUEUE_ROOT) and ccp on
# PATH, refuse a commit on the integration branch that changes a leased task's file. The override above
# does not lift this one.
if [ -n "${QUEUE_ROOT:-}" ] && command -v ccp >/dev/null 2>&1; then
  ccp tasks check --lease --staged >&2 || {
    echo "pre-commit: send the amendment to the runner holding the task; it lands in the task's PR" >&2
    exit 1
  }
fi
exit 0
