#!/usr/bin/env python3
# ccp — the control plane's product tool (SPEC §8). Runs from any clone without installing:
#   "$PLANE/bin/ccp" tasks next
# Or install once: pipx install -e "$PLANE"
# It finds the plane by its own path (through symlinks) and imports it from there. It sets no
# environment variable, so what `ccp` runs (`ccp suite run`'s command, a product check) sees the
# caller's environment, not a launcher's PYTHONPATH (SPEC §14.1).
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from ccp.cli import main  # noqa: E402

sys.exit(main())
