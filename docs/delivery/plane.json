{
  "project_id": "control-plane",
  "language": "python",
  "package_docs": {
    "doc_name": "CLAUDE.md",
    "exempt_dirs": [
      ".git",
      ".github",
      ".idea",
      ".claude",
      "docs",
      "node_modules",
      "__pycache__",
      ".venv",
      ".claude-plugin",
      "plugin",
      "agents",
      "skills",
      "templates",
      "queue",
      "scripts/queue",
      "tests/data"
    ],
    "docstring_globs": [
      "ccp/**/*.py",
      "scripts/observability/*.py"
    ],
    "source_suffixes": [
      ".py",
      ".sql",
      ".json",
      ".md",
      ".sh"
    ]
  },
  "adr": {
    "dir": "docs/adr",
    "index": "docs/adr/INDEX.md",
    "strict": true
  },
  "docs": {
    "checks": [
      {
        "id": "leak-check",
        "cmd": "scripts/leak-check.sh"
      },
      {
        "id": "merge-helper",
        "cmd": "! git grep -n -e merge-tree -e patch-id -e remerge-diff -- ccp ':(exclude)ccp/gitmerge.py'"
      },
      {
        "id": "config-reader",
        "cmd": "! git grep -nE 'plane\\.json\"\\)\\.read_text' -- plugin scripts"
      },
      {
        "id": "language-pack",
        "cmd": "! git grep -n unittest -- ccp ':(exclude)ccp/doclang'"
      }
    ],
    "workers": 4
  },
  "suite": {
    "lanes": {
      "gate": [
        "scripts/gate.sh"
      ],
      "full": [
        "scripts/gate.sh"
      ]
    },
    "exclusive_lanes": [
      "gate",
      "full"
    ]
  },
  "auth_check": {
    "probes": [
      {
        "id": "gh",
        "cmd": "gh auth status >/dev/null 2>&1"
      },
      {
        "id": "claude_login",
        "cmd": "claude auth status 2>/dev/null | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get(\"loggedIn\") else 1)'"
      }
    ]
  },
  "estimate": {
    "auto": true
  },
  "parallel": {
    "max_in_flight": 3,
    "schedule": "clashes"
  },
  "mutate": {
    "command": "python3 -B -m unittest -q {test}"
  },
  "verify": {
    "skip_review_after_clean": true,
    "accept_cache": {
      "max_age_days": 7
    }
  },
  "upgrade": {
    "taken": {
      "0164-clashes-with-and-schedule": "plane.json parallel.schedule clashes (PR 191)",
      "0019-parallel-doc-checks": "plane.json docs.workers 4 (PR #191)",
      "0112-parallel-gate-and-slow-modules": "the plane's own gate.sh already runs gate_parallel.py"
    }
  }
}
