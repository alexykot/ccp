{
  "project_id": "control-plane",
  "language": "python",
  "architect": {
    "shape_from_task": "0197",
    "checks": [
      {
        "id": "E2",
        "cmd": "test -z \"$(git branch --list 'state/*')\""
      },
      {
        "id": "E3",
        "cmd": "scripts/leak-check.sh"
      },
      {
        "id": "E4",
        "cmd": "! git grep -nE '= test_[a-z_]+\\.[A-Z][A-Za-z]+\\.[a-z_]+' -- tests && ! git grep -n '\\.plane-runtime' -- 'tests/test_*.py' ':(exclude)tests/test_plane_json_constants.py' && test \"$(LC_ALL=C git grep -hE 'assert(Not)?In\\(\"[^\"]{40,}' -- 'tests/*.py' | wc -l)\" -le 345"
      },
      {
        "id": "E13",
        "cmd": "test -z \"$(awk 'length > 600' templates/prompts/*.md)\""
      },
      {
        "id": "E14",
        "cmd": "! git grep -n -e merge-tree -e patch-id -e remerge-diff -- ccp ':(exclude)ccp/gitmerge.py'"
      },
      {
        "id": "E16",
        "cmd": "! git grep -nE '(plane\\.json\"|CONFIG_REL)\\)\\.read_text' -- ccp plugin scripts ':(exclude)ccp/config.py'"
      },
      {
        "id": "E18",
        "cmd": "! git grep -n unittest -- ccp ':(exclude)ccp/doclang'"
      },
      {
        "id": "E19",
        "cmd": "! git grep -nE 'CCP_GH_BIN|headRefOid|mergeCommit' -- ccp ':(exclude)ccp/prhost.py' && ! git grep -n 'gh pr' -- templates plugin/agents && ! git grep -n 'refs/pull' -- ccp ':(exclude)ccp/prhost.py'"
      },
      {
        "id": "E22",
        "cmd": "! git grep -n CHECK_RE -- ccp ':(exclude)ccp/tasklog.py'"
      },
      {
        "id": "E27",
        "cmd": "! git grep -n '\"design-seat\"' -- ccp scripts ':(exclude)ccp/board_page.html' ':(exclude)scripts/observability/lib.py'"
      }
    ]
  },
  "models": {
    "implementer_small": "sonnet",
    "implementer_refactor": "sonnet"
  },
  "package_docs": {
    "claude_md_dirs": [
      "ccp",
      "ccp/doclang",
      "contracts",
      "scripts",
      "scripts/git-hooks",
      "scripts/observability",
      "tests"
    ],
    "exempt_dirs": [
      ".git",
      ".github",
      ".idea",
      ".claude",
      "docs",
      "node_modules",
      "__pycache__",
      ".venv",
      ".claude-plugin",
      "plugin",
      "agents",
      "skills",
      "templates",
      "queue",
      "scripts/queue",
      "tests/data"
    ],
    "docstring_globs": [
      "ccp/**/*.py",
      "scripts/observability/*.py"
    ],
    "source_suffixes": [
      ".py",
      ".sql",
      ".json",
      ".md",
      ".sh"
    ]
  },
  "adr": {
    "dir": "docs/adr",
    "index": "docs/adr/INDEX.md",
    "strict": true
  },
  "suite": {
    "lanes": {
      "gate": [
        "scripts/gate.sh"
      ],
      "part": [
        "scripts/gate.sh"
      ]
    },
    "exclusive_lanes": [
      "gate"
    ]
  },
  "auth_check": {
    "probes": [
      {
        "id": "gh",
        "cmd": "gh auth status >/dev/null 2>&1"
      },
      {
        "id": "claude_login",
        "cmd": "claude auth status 2>/dev/null | python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get(\"loggedIn\") else 1)'"
      }
    ]
  },
  "estimate": {
    "auto": true
  },
  "parallel": {
    "max_in_flight": 3,
    "schedule": "clashes"
  },
  "mutate": {
    "command": "python3 -B -m unittest -q {test}"
  },
  "verify": {
    "skip_review_after_clean": true,
    "accept_cache": {
      "max_age_days": 7
    }
  },
  "upgrade": {
    "taken": {
      "0164-clashes-with-and-schedule": "plane.json parallel.schedule clashes (PR 191)",
      "0019-parallel-doc-checks": "plane.json docs.workers 4 (PR #191)",
      "0112-parallel-gate-and-slow-modules": "the plane's own gate.sh already runs gate_parallel.py",
      "0181-models-block-and-role-defaults": "plane.json models implementer_small and implementer_refactor sonnet; .claude/settings.json model opus (PR #221)",
      "0182-language-is-a-required-key": "plane.json language python (PR #221)",
      "0183-gate-lane-is-required": "the plane's own suite.lanes.gate already runs scripts/gate.sh",
      "0185-architect-on-by-default": "plane.json architect.shape_from_task 0197 (PR #221)",
      "0187-short-plane-json": "plane.json: no removed or merged key is set (PR #221)",
      "0192-plane-json-constants-and-defaults": "plane.json: package_docs.doc_name and docs.workers deleted, the constants apply (PR #221)"
    }
  }
}
